[Unit]
Description=alig.tech Health scan ({{ tarama_portu }})
After=network.target

[Service]
User={{ servis_kullanici }}
Group={{ servis_kullanici }}
EnvironmentFile=/etc/alig/env
{% if eposta_dogrulama %}
# The report link goes only by e-mail; the alig-posta service does the sending (this unit does not reach the network).
Environment=ALIG_EPOSTA_DOGRULAMA=1
Environment=ALIG_SITE_ADRESI=https://{{ alan_adi }}
{% endif %}
{% if musteri_portali %}
# The customer portal is on (e-mail verification must also be on; tarama/server.py does not start otherwise).
Environment=ALIG_PORTAL=1
{% endif %}
{% if dogrudan_baglanti %}
# Mode B is on: the scan is handed over to the separate runner service through a local socket. This unit does not connect outward.
Environment=ALIG_DOGRUDAN=1
Environment=ALIG_CALISTIRICI_SOKETI=/run/alig-calistirici/calistirici.sock
SupplementaryGroups={{ calistirici_kullanici }}
{% endif %}
ExecStart=/usr/bin/python3 {{ kok_dizin }}/current/tarama/server.py --db {{ veri_dizini }}/tarama.sqlite --host 127.0.0.1 --port {{ tarama_portu }}
Restart=on-failure
RestartSec=2
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ veri_dizini }}
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target

# Until the certificate is obtained: only ACME and redirect
server {
    listen 80;
    listen [::]:80;
    server_name {{ alan_adi }} {{ www_alani }};
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 200 "alig.tech is being set up\n"; add_header Content-Type text/plain; }
}

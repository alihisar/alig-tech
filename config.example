# Example environment file for the form service. Write the real values NOT under deploy/,
# but on the server in /etc/alig/form.env (permissions 0600, owned by alig-form).

ALIG_FORM_BIND=127.0.0.1
ALIG_FORM_PORT=8081
ALIG_FORM_DB=/var/lib/alig-form/iletisim.sqlite3
# Record retention period (days). The IP address is personal data.
ALIG_FORM_RETENTION_DAYS=30
# The SMTP details for the notification e-mail are filled in on the server.
ALIG_SMTP_HOST=CHANGE_ME
ALIG_SMTP_USER=CHANGE_ME
ALIG_SMTP_PASSWORD=CHANGE_ME
ALIG_NOTIFY_TO=CHANGE_ME
